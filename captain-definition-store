{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:18-alpine",
    "WORKDIR /app",
    
    "COPY frontend/package.json frontend/package-lock.json ./",
    "RUN npm install",
    
    "COPY frontend/ .",
    
    "ENV NODE_ENV=production",
    "ENV PORT=8000",
    "RUN npm run build",
    
    "EXPOSE 8000",
    
    "CMD [\"sh\", \"-c\", \"next start -p 8000\"]"
  ]
}
