    "@medusajs/cli": "2.8.8",
    "@medusajs/event-bus-redis": "2.8.8",
    "@medusajs/file": "2.8.8",
    "@medusajs/file-local": "2.8.8",
    "@medusajs/framework": "2.8.8",
    "@medusajs/icons": "2.8.8",
    "@medusajs/medusa": "2.8.8",
    "@medusajs/notification": "2.8.8",
