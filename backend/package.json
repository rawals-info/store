    "@mikro-orm/postgresql": "6.4.3",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "awilix": "^8.0.1",
    "axios": "^1.10.0",
    "cloudinary": "^2.7.0",
    "medusa-file-cloudinary": "^1.0.2",
    "medusa-plugin-razorpay-v2": "^0.1.2",
    "pg": "^8.13.0",
